		sourceColumn: Chave_Equipe

		annotation SummarizationSetBy = Automatic

	partition dFuncionarios = m
		mode: import
		source =
				let
				    // 1. Prepara a tabela de Vendedores com Chave Única (Prefixo "V-")
				    VendedoresBase = Table.SelectColumns(dVendedores, {"codigo_vendedor", "vendedor", "codigo_filial", "ativo"}),
				    VendedoresRenomeado = Table.RenameColumns(VendedoresBase, {
				        {"codigo_vendedor", "Codigo_Original"},
				        {"vendedor", "Nome"}
				    }),
				    VendedoresTipo = Table.AddColumn(VendedoresRenomeado, "Tipo", each "Vendedor", type text),
				    VendedoresChave = Table.AddColumn(VendedoresTipo, "Chave_Equipe", each "V-" & Text.From([Codigo_Original]), type text),
				
				    // 2. Prepara a tabela de Profissionais com Chave Única (Prefixo "P-")
				    ProfissionaisBase = Table.SelectColumns(dProfissionais, {"codigo_profissional", "profissional", "codigo_filial", "ativo"}),
				    ProfissionaisRenomeado = Table.RenameColumns(ProfissionaisBase, {
				        {"codigo_profissional", "Codigo_Original"},
				        {"profissional", "Nome"}
				    }),
				    ProfissionaisTipo = Table.AddColumn(ProfissionaisRenomeado, "Tipo", each "Profissional", type text),
				    ProfissionaisChave = Table.AddColumn(ProfissionaisTipo, "Chave_Equipe", each "P-" & Text.From([Codigo_Original]), type text),
				
				    // 3. Acrescenta (Unifica) as duas tabelas
				    TabelaUnificada = Table.Combine({VendedoresChave, ProfissionaisChave}),
				
				    // 4. Cria a coluna Status (Ativo / Inativo)
				    AdicionaStatus = Table.AddColumn(TabelaUnificada, "Status", each if [ativo] = true then "Ativo" else "Inativo", type text),
				    RemoveAtivo = Table.RemoveColumns(AdicionaStatus, {"ativo"}),
				
				    // 5. Padroniza os tipos ANTES de mesclar com dFiliais (evita erro de tipo no relacionamento/merge)
				    TiposBase = Table.TransformColumnTypes(RemoveAtivo, {
				        {"Chave_Equipe", type text},
				        {"Codigo_Original", Int64.Type},
				        {"Nome", type text},
				        {"codigo_filial", Int64.Type},
				        {"Tipo", type text},
				        {"Status", type text}
				    }),
				
				    // 6. Traz o nome da Filial direto para a dimensão (Desnormalização - dispensa relacionamento Snowflake)
				    MergeFiliais = Table.NestedJoin(TiposBase, {"codigo_filial"}, dFiliais, {"codigo_filial"}, "dFiliais", JoinKind.LeftOuter),
				    #"Reordered Columns" = Table.ReorderColumns(MergeFiliais,{"Codigo_Original", "Chave_Equipe", "Nome", "codigo_filial", "Tipo", "Status", "dFiliais"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Reordered Columns",{"dFiliais"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

