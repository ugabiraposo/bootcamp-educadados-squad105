table 'Medidas metas'
	lineageTag: 84e2f1c0-cf55-4547-add2-f710f35ffe55

	measure 'val vendedor' = CALCULATE([meta de valor], fMetas_valor[nivel] = "Vendedor")
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: bc7743ce-6338-4c27-b5d0-d34384d420f5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'qtde vendedor' = CALCULATE([meta de quantidade], fMetas_quantidade[nivel] = "Vendedor")
		formatString: #,0
		lineageTag: fd2966dc-1af5-4faa-8cad-c2bebb222e82

	measure 'val profissional' = CALCULATE([meta de valor], fMetas_valor[nivel] = "Profissional")
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: f9461f28-55a4-4703-bb95-16f40de0d5e5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'qtde profissional' = CALCULATE([meta de quantidade], fMetas_quantidade[nivel] = "Profissional")
		formatString: #,0
		lineageTag: 28b6a8b3-89a3-474f-b5a2-880bed157750

	measure 'val grupos' = ```
			CALCULATE([meta de valor], 
			USERELATIONSHIP(dGrupos_servico[codigo_grupo_servico], fMetas_valor[codigo_grupo_servico]), 
			fMetas_valor[nivel] = "Produto")
			```
		lineageTag: 47297e65-3ca9-445b-bc53-7bf814f88d0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'qtde grupos' = ```
			CALCULATE([meta de quantidade], 
			USERELATIONSHIP(dGrupos_servico[codigo_grupo_servico], fMetas_quantidade[codigo_grupo_servico]), 
			fMetas_quantidade[nivel] = "Produto")
			```
		formatString: 0
		lineageTag: 35c3bd40-e84b-4761-8f36-0226cf9ea1b9

	measure 'val serviços' = ```
			CALCULATE([meta de valor], 
			USERELATIONSHIP(dServicos[codigo_servico], fMetas_valor[codigo_servico]), 
			fMetas_valor[nivel] = "Serviço")
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 65f11e3f-e5bb-4eb0-b5d0-d6d9697672b7

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'qtde serviços' = ```
			CALCULATE([meta de quantidade], 
			USERELATIONSHIP(dServicos[codigo_servico], fMetas_quantidade[codigo_servico]), 
			fMetas_quantidade[nivel] = "Serviço")
			```
		formatString: #,0
		lineageTag: 1e404201-ad23-4c45-a1c6-039728bba94f

	measure 'val cidade' = ```
			calculate([val filial], 
			REMOVEFILTERS(dFiliais[filial],
			dFiliais[regional], 
			dFiliais[filial_abreviado]),
			REMOVEFILTERS( dVendedores[vendedor]),
			REMOVEFILTERS(dProfissionais[profissional]))
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: d204e122-6976-4b36-9598-1625ca14b54b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'qtde cidade' = ```
			calculate([qtde filial], 
			REMOVEFILTERS(dFiliais[filial],
			dFiliais[regional], 
			dFiliais[filial_abreviado]),
			REMOVEFILTERS( dVendedores[vendedor]),
			REMOVEFILTERS(dProfissionais[profissional]))
			```
		formatString: 0
		lineageTag: 0a5c7916-b600-4dc9-9ea6-27aee2e81b44

	measure 'val rede' = ```
			calculate([val filial], 
			REMOVEFILTERS(dFiliais[filial],
			dFiliais[regional], 
			dFiliais[filial_abreviado]),
			REMOVEFILTERS( dVendedores[vendedor]),
			REMOVEFILTERS(dProfissionais[profissional]),
			REMOVEFILTERS(dCidades[cidade],
			dCidades[uf],
			dCidades[regiao],
			dCidades[estado]))
			```
		formatString: 0
		lineageTag: 19a37ed6-d02b-42ce-944d-402f075db76e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'qtde rede' = ```
			calculate([qtde filial], 
			REMOVEFILTERS(dFiliais[filial],
			dFiliais[regional], 
			dFiliais[filial_abreviado]),
			REMOVEFILTERS( dVendedores[vendedor]),
			REMOVEFILTERS(dProfissionais[profissional]),
			REMOVEFILTERS(dCidades[cidade],
			dCidades[uf],
			dCidades[regiao],
			dCidades[estado]))
			```
		formatString: 0
		lineageTag: b1a2233e-00af-4891-a9fe-d9c5d2e6e332

	measure 'val filial' =
			CALCULATE([meta de valor],
			fMetas_valor[nivel] = "Produto")
		lineageTag: 17d21c44-b54d-454c-bc60-114a23f79fde

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'qtde filial' =
			CALCULATE([meta de quantidade],
			fMetas_quantidade[nivel] = "Vendedor")
		formatString: 0
		lineageTag: 58da23be-e81d-498a-9930-125c607781f1

	measure 'valor metas-filial' =
			
			CALCULATE(
			    SUM(fMetas_valor[meta_valor]),
			    REMOVEFILTERS(dCalendario),
			    dCalendario[ano] = 2026
			)
		formatString: 0
		lineageTag: 841e65ca-2025-4f95-bb92-0c1ef8a71594

	measure 'qtde metas-filial' = ```
			
			CALCULATE(
			    SUM(fMetas_quantidade[meta_quantidade]),
			    REMOVEFILTERS(dCalendario),
			    dCalendario[ano] = 2026
			)
			
			```
		formatString: 0
		lineageTag: 86750d89-6f6c-4d16-9ee5-27315f0e8e49

	measure resultado-meta-filial =
			
			VAR vlr = COALESCE([valor metas-filial], 0)
			VAR vQtd = COALESCE([qtde metas-filial], 0)
			RETURN
			    IF(vlr > 0 || vQtd > 0, 1, 0)
		formatString: 0
		lineageTag: 8a52144c-b511-4308-948e-87c4258d54b5

	measure 'status meta-filial' =
			
			VAR temValor = COALESCE([valor metas-filial], 0) > 0
			VAR temQtde = COALESCE([qtde metas-filial], 0) > 0
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT temValor && NOT temQtde, "sem meta",
			        NOT temValor && temQtde, "Sem meta de Valor",
			        temValor && NOT temQtde, "Sem meta de Quantidade",
			        "Com meta definida"
			    )
		lineageTag: 71d316f1-18fb-465e-a19a-1eb96a948e9a

	measure 'sem meta-filial' =
			
			IF(
			    [resultado-meta-filial] = 0,
			    "sem meta",
			    "Com meta"
			)
		lineageTag: 2b7d305b-18a3-49bb-b37b-057bcac6f219

	measure 'filiais sem meta' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        [resultado-meta-filial] = 0
			    )
			) + 0
		formatString: 0
		lineageTag: 587c478c-0f2e-4d77-821c-6a0a3cd45cf1

	measure 'filiais sem meta-valor' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        COALESCE([valor metas-filial], 0) <= 0
			    )
			) + 0
		formatString: 0
		lineageTag: 8884e7a5-c4c1-446f-a551-1199b3f16ae3

	measure 'filiais sem meta-qtde' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        COALESCE([qtde metas-filial], 0) <= 0
			    )
			) + 0
		formatString: 0
		lineageTag: bea3b342-5f54-4ec6-bc84-412b2653476c

	measure 'ating qtde-filial' =
			
			DIVIDE([número de vendas], [qtde filial])
		lineageTag: 71b7033e-b7e1-43df-9cc7-e2823c1f8785

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ating valor-filial' =
			
			DIVIDE([valor líquido], [val filial])
		lineageTag: 23043d90-e679-49b1-9cbf-6b36f8eb09b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'faixa ating-valor' =
			
			VAR vPct = [ating valor-filial]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vPct), "sem meta",
			        vPct >= 1,     "100% ou mais",
			        vPct >= 0.9,   "90% a 99%",
			        "abaixo de 90%"
			    )
		lineageTag: c476ca21-6137-4315-abf7-9a2360b4e083

	measure 'faixa ating-qtde' =
			
			VAR vPct = [ating qtde-filial]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vPct), "sem meta",
			        vPct >= 1,     "100% ou mais",
			        vPct >= 0.9,   "90% a 99%",
			        "abaixo de 90%"
			    )
		lineageTag: 74c7d418-3726-4150-90d3-91d836af4494

	measure 'filiais bateram valor' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        [ating valor-filial] >= 1
			    )
			) + 0
		formatString: 0
		lineageTag: d614ffeb-30c2-45d3-9b49-38f24014cd9d

	measure 'filiais bateram qtde' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        [ating qtde-filial] >= 1
			    )
			) + 0
		formatString: 0
		lineageTag: 5a3ef801-c82b-4ce6-a64c-5096c06e02e7

	measure 'filiais bateram valor ñ quantidade' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        [ating valor-filial] >= 1
			            && NOT ISBLANK([ating qtde-filial])
			            && [ating qtde-filial] < 1
			    )
			) + 0
		formatString: 0
		lineageTag: c50c2e0b-89f0-443b-b115-983a40b2278d

	measure 'filiais bateram quantidade ñ valor' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dFiliais[codigo_filial]),
			        [ating qtde-filial] >= 1
			            && NOT ISBLANK([ating valor-filial])
			            && [ating valor-filial] < 1
			    )
			) + 0
		formatString: 0
		lineageTag: ac4c1a0c-dd7d-4df2-9709-bc591e60b9be

	partition 'Medidas metas' = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

