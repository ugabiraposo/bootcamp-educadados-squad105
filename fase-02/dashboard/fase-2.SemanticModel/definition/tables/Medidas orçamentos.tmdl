table 'Medidas orçamentos'
	lineageTag: cf209dd3-617e-46a8-9b82-2c2d7ac67e88

	measure 'orçamentos gerados' =
			
			COUNTROWS(fOrcamentos)
		formatString: 0
		lineageTag: 0c3c78e2-0ab7-424c-a894-00c5c48e83e9

	measure 'orçamentos aprovados' =
			
			CALCULATE(
			    [orçamentos gerados],
			    fOrcamentos[status] = "Aprovado"
			)
		formatString: 0
		lineageTag: f1fb4064-af18-4219-81b9-99ad036c984e

	measure 'orçamentos perdidos' =
			
			CALCULATE(
			    [orçamentos gerados],
			    fOrcamentos[status] = "Perdido"
			)
		formatString: 0
		lineageTag: d15343ef-2c6d-4ff4-8235-a3f3ef6ee661

	measure 'gerados %' = divide([orçamentos gerados], [orçamentos gerados])
		lineageTag: fc006cb1-00f7-4868-80b2-d0918298542f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'aprovados %' = divide([orçamentos aprovados], [orçamentos gerados])
		lineageTag: f9724614-c4be-44e6-aaf7-82a9209cb692

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'perdidos %' = divide([orçamentos perdidos], [orçamentos gerados])
		lineageTag: d4ea1060-225b-496c-92ed-c1c0d1b67044

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Medidas orçamentos' = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

