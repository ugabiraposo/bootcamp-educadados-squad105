table 'Medidas especiais'
	lineageTag: 1c862f21-c531-41d7-98d0-731ae36d51e1

	measure 'status val vendedor' =
			CALCULATE( SWITCH(true(),
			[val vendedor %] = "sem meta","FFFFFF",
			[val vendedor %] > 1, "#1E4D2B",
			[val vendedor %] < 1, "#5C1D24"), fMetas_valor[nivel] = "Vendedor")
		lineageTag: 7d01417f-afcd-47b6-bef2-533c01246de7

	measure 'status qtde vendedor' =
			CALCULATE( SWITCH(true(),
			[qtde vendedor %] = "sem meta","FFFFFF",
			[qtde vendedor %] > 1, "#1E4D2B",
			[qtde vendedor %] < 1, "#5C1D24"), fMetas_quantidade[nivel] = "Vendedor")
		lineageTag: b5e4162d-ba9a-45fd-a198-706bc84fc983

	measure 'status val profissional' =
			CALCULATE( SWITCH(true(),
