		lineageTag: 45a1e154-4505-49e0-b40f-f0ed183fdb5c

	measure 'rótulo especial' =
			
			var valFormat = SWITCH(true(),
			[valor líquido] > 999999999, format([valor líquido], "#\.###\.###\.###"),
			[valor líquido] > 999999, format([valor líquido], "#\.###\.###"),
			[valor líquido] > 999, format([valor líquido], "#\.###"),
			format([valor líquido], "###"))
			var qtdeFormat = if([número de vendas] > 999, format([número de vendas], "#\.###"), format([número de vendas], "###"))
			return "R$ " & valformat & " | Qtd " & qtdeformat
		lineageTag: 712cc494-5589-4975-ab6e-28474760c9ff

	measure 'Destaque - Filial Líder' = ```
			
			VAR Ranking =
			    TOPN(
			        1,
			        FILTER(
			            ADDCOLUMNS(
			                VALUES('dFiliais'[filial_abreviado]),
			                "@Valor", [valor líquido]
			            ),
			            NOT ISBLANK([@Valor])
			        ),
			        [@Valor], DESC,
			        'dFiliais'[filial_abreviado], ASC
			    )
			RETURN
			    IF(
			        ISEMPTY(Ranking),
			        "Aguardando dados",
			        CONCATENATEX(
			            Ranking,
			            'dFiliais'[filial_abreviado]
			                & " · "
			                & FORMAT([@Valor], "R$ #,##0.00")
			        )
			    )
			
			```
		lineageTag: 272d27df-01b8-4230-ab55-b8c9a555dd33

