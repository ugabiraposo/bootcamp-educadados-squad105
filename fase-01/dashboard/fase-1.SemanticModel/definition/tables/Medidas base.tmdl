table 'Medidas base'
	lineageTag: 3e07e608-f740-450a-b1ad-4f9c5071dbc8

	measure 'valor líquido' = sum(fVendas[valor_liquido])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: e1b7ca5b-0a51-4015-bfe1-6f431d93f2f8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'número de vendas' = DISTINCTCOUNT(fVendas[codigo_venda])
		formatString: #,0
		lineageTag: 7b613db3-ab36-479a-9bc9-d2694d6b29b8

	measure 'valor bruto' = sum(fItens_venda[valor_total])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 559e4245-f889-440d-b9fd-bb02881dd615

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'quantidade de itens' = sum(fItens_venda[quantidade])
		formatString: #,0
		lineageTag: a3746fbe-5b00-4daf-a28d-db904c38467a

	measure 'meta de valor' = sum(fMetas_valor[meta_valor])
		lineageTag: 82fd6b2a-21e9-46dc-9752-31aff5fbf9fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'meta de quantidade' = sum(fMetas_quantidade[meta_quantidade])
		formatString: 0
		lineageTag: 50510b64-bcd7-4b7a-968a-b3f4c2f9c90d

	measure 'Destaque - Filial Líder' = ```
			
			VAR Ranking =
			    TOPN(
			        1,
			        FILTER(
			            ADDCOLUMNS(
			                VALUES('dFiliais'[filial_abreviado]),
			                "@Valor", [valor líquido]
			            ),
			            NOT ISBLANK([@Valor])
			        ),
			        [@Valor], DESC,
			        'dFiliais'[filial_abreviado], ASC
			    )
			RETURN
			    IF(
			        ISEMPTY(Ranking),
			        "Aguardando dados",
			        CONCATENATEX(
			            Ranking,
			            'dFiliais'[filial_abreviado]
			                & " · "
			                & FORMAT([@Valor], "R$ #,##0.00")
			        )
			    )
			
			```
		lineageTag: d7237a46-fc4a-4387-a505-e64d889d97a6

	partition 'Medidas base' = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	changedProperty = Name

	annotation PBI_ResultType = Table

